# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/athlo_club"

# Auth.js — generate a secret with `npx auth secret` or `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Sign in with Google). Leave blank in dev if you don't need it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link) provider. EMAIL_SERVER is an SMTP connection string,
# e.g. "smtp://user:pass@smtp.mailtrap.io:587".
EMAIL_SERVER=""
EMAIL_FROM="Athlo Club <no-reply@athloclub.com>"

# Stripe (Connect + subscriptions). Leave blank in dev — the stub routes in
# app/api/stripe/* no-op safely without these.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""
